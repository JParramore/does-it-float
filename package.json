{
  "name": "does-it-float",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "experiment": "tsx experiments/index.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"experiments/**/*.ts\" vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"experiments/**/*.ts\" vite.config.ts",
    "lint": "npm run format && oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
